{
  "openapi": "3.0.3",
  "info": {
    "title": "BookLeaf Publishing - Author Support & Communication Portal API",
    "description": "Production-grade RESTful API for BookLeaf Publishing's dual Author & Operations Admin Support Portal with AI-assisted classification, priority scoring, knowledge base retrieval, and real-time updates.",
    "version": "1.0.0",
    "contact": {
      "name": "BookLeaf Publishing Operations Team",
      "email": "support@bookleafpublishing.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT token received from /api/v1/auth/login"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Subject must be at least 3 characters long" }
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "example": "aarav.sharma@example.com" },
          "password": { "type": "string", "example": "password123" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsIn..." },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "example": "AUTH001" },
              "name": { "type": "string", "example": "Priya Sharma" },
              "email": { "type": "string", "example": "priya.sharma@email.com" },
              "role": { "type": "string", "enum": ["author", "admin"], "example": "author" }
            }
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "TKT-1001" },
          "author_id": { "type": "string", "example": "AUTH001" },
          "book_id": { "type": "string", "nullable": true, "example": "BK001" },
          "subject": { "type": "string", "example": "Delayed royalty payment for Q3 cycle" },
          "description": { "type": "string", "example": "I published my book 4 months ago and still haven't received any royalty." },
          "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved", "Closed"], "example": "In Progress" },
          "ai_category": { "type": "string", "example": "Royalty & Payments" },
          "ai_priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"], "example": "High" },
          "ai_priority_score": { "type": "integer", "example": 85 },
          "ai_rationale": { "type": "string", "example": "Overdue royalty inquiry with financial frustration." },
          "effective_category": { "type": "string", "example": "Royalty & Payments" },
          "effective_priority": { "type": "string", "example": "High" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateTicketRequest": {
        "type": "object",
        "required": ["subject", "description"],
        "properties": {
          "book_id": { "type": "string", "nullable": true, "example": "BK001" },
          "subject": { "type": "string", "example": "Author copies print defect" },
          "description": { "type": "string", "example": "Received author copies with misaligned pages and blurry images." }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate author or admin",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Successful login", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/auth/demo-accounts": {
      "get": {
        "summary": "Retrieve test credentials for one-click testing",
        "responses": {
          "200": { "description": "List of demo author and admin credentials" }
        }
      }
    },
    "/api/v1/books": {
      "get": {
        "summary": "Get published books and royalty summary",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Books list with sales and royalty calculations" }
        }
      }
    },
    "/api/v1/tickets": {
      "get": {
        "summary": "List support tickets (role-scoped)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "priority", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "oldest", "oldest_unresolved", "priority_desc"] } }
        ],
        "responses": {
          "200": { "description": "List of matching tickets" }
        }
      },
      "post": {
        "summary": "Raise a new support ticket",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTicketRequest" } } }
        },
        "responses": {
          "201": { "description": "Ticket raised and auto-classified by AI" }
        }
      }
    },
    "/api/v1/tickets/{id}": {
      "get": {
        "summary": "Get ticket details and message thread",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Ticket details" }
        }
      },
      "patch": {
        "summary": "Update ticket status or override AI classification (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Ticket updated" }
        }
      }
    },
    "/api/v1/tickets/{id}/messages": {
      "post": {
        "summary": "Add a response message to ticket thread",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Message added" }
        }
      }
    },
    "/api/v1/tickets/{id}/notes": {
      "post": {
        "summary": "Add internal note hidden from author (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Internal note saved" }
        }
      }
    },
    "/api/v1/tickets/{id}/ai-draft": {
      "post": {
        "summary": "Generate AI-drafted response grounded in BookLeaf Knowledge Base (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Grounded AI response draft with token metrics" }
        }
      }
    },
    "/api/v1/admin/stats": {
      "get": {
        "summary": "Get operations analytics and SLA breakdown (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Operations dashboard metrics" }
        }
      }
    },
    "/api/v1/admin/authors": {
      "get": {
        "summary": "List all authors with catalog summaries (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of authors" }
        }
      }
    },
    "/api/v1/system/health": {
      "get": {
        "summary": "System health probe",
        "responses": {
          "200": { "description": "Health status" }
        }
      }
    },
    "/api/v1/system/reset-seed": {
      "post": {
        "summary": "Reset database to initial sample dataset",
        "responses": {
          "200": { "description": "Database reset result" }
        }
      }
    }
  }
}
